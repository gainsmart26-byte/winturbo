{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/dashboard.html",
      "has": [{ "type": "host", "value": "winturbo.io" }]
    },
    {
      "source": "/",
      "destination": "/turboman.html",
      "has": [
        {
          "type": "host",
          "value": "winturbo.live"
        }
      ]
    }
  ]
}
